        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Process Ultrasonic & Vehicle Data",
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "var leftFront = typeof msg.left_front !== 'undefined' ? parseFloat(msg.left_front) : null;\nvar rightFront = typeof msg.right_front !== 'undefined' ? parseFloat(msg.right_front) : null;\n\nvar dist = null;\nif (leftFront !== null && rightFront !== null) {\n    dist = Math.min(leftFront, rightFront);\n} else if (leftFront !== null) {\n    dist = leftFront;\n} else if (rightFront !== null) {\n    dist = rightFront;\n}\n\nvar isVehicleDetected = dist !== null && dist > 0 && dist <= 50.0;\nvar relayState = isVehicleDetected ? \"ON\" : \"OFF\";\nvar warnStatus = (dist !== null && dist > 0 && dist < 20.0) ? \"DANGER\" : (isVehicleDetected ? \"WARNING\" : \"NORMAL\");\n// Buzzer is physically wired on the sensor-node and beeps in sync with relay\n// (same ON/OFF condition); this field only mirrors that state for display.\nvar buzzerState = relayState;\n\nvar newMsg = {\n    \"vehicle_detected\": isVehicleDetected,\n    \"warning_status\": warnStatus,\n    \"relay\": relayState,\n    \"buzzer\": buzzerState,\n    \"source_device\": \"sensor-node\"\n};\nif (leftFront !== null) { newMsg[\"left_front\"] = leftFront; }\nif (rightFront !== null) { newMsg[\"right_front\"] = rightFront; }\n\nreturn {\n    msg: newMsg,\n    metadata: metadata,\n    msgType: \"POST_ATTRIBUTES_REQUEST\"\n};",
          "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
          "description": "Standardizes ultrasonic distance, temperature, humidity, vehicle detection, and relay state.",
